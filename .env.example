# DIQQAT (real serverga o'rnatishda): APP_ENV=production, APP_DEBUG=false va APP_URL=https://... qiling.
# APP_DEBUG=true bo'lsa, xatolik sahifalarida server yo'llari va sozlamalar (sirlar emas, lekin ichki
# tuzilma) ko'rinib qoladi - shuning uchun jonli serverda albatta false. "Tizim holati" sahifasi buni
# unutib qo'yilgan bo'lsa ogohlantiradi.
APP_NAME="Edunova CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz

# "daily" - loglar kuniga bitta faylga yoziladi va 14 kundan eskisi avtomatik o'chadi (LOG_DAILY_DAYS).
# "stack" + "single" (eski standart) bitta laravel.log faylini cheksiz kattalashtiradi - serverda tavsiya etilmaydi.
LOG_CHANNEL=daily
# Jonli serverda "warning" qiling (faqat muammolar yoziladi) - "debug" yozishda foydali, lekin serverda
# faylni tezroq to'ldiradi.
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edunova_crm
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=240
# Jonli serverda https bo'lsa true qiling - sessiya cookie'si faqat https orqali yuboriladi.
# Bo'sh qoldirilsa, so'rov https bo'lganda Laravel o'zi xavfsiz deb belgilaydi.
SESSION_SECURE_COOKIE=
CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Birinchi sAdmin akkaunti (php artisan db:seed paytida yaratiladi)
SADMIN_NAME="Bosh administrator"
SADMIN_USERNAME=sadmin
SADMIN_PASSWORD=

# Eskiz.uz (umumiy akkaunt). Filialning o'z akkaunti bo'lsa, filial sozlamalarida kiritiladi.
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# OpenAI (kalitni faqat shu yerga yozing, boshqa joyga yozmang)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_DAILY_LIMIT=200

# v11: Firebase Cloud Messaging (mobil ilova push-bildirishnomasi). Firebase konsolidan
# "Project settings -> Service accounts -> Generate new private key" orqali JSON fayl olinadi,
# serverga (masalan storage/app/firebase-service-account.json) yuklanadi va bu yerga yo'li yoziladi.
# Ikkalasi ham bo'lmasa, push jim o'tkazib yuboriladi (ilova ichidagi bildirishnomalar ro'yxati
# baribir ishlayveradi) - API_DOC.md'da to'liq ko'rsatma bor.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
